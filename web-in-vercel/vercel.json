{
  "version": 2,
  "name": "mangastudio-ai",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/batch-studio",
      "destination": "/batch-studio/index.html"
    },
    {
      "source": "/batch-studio/",
      "destination": "/batch-studio/index.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
