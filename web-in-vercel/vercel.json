{
  "version": 2,
  "name": "mangastudio-ai",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/batch-studio",
      "destination": "/batch-studio/index.html"
    },
    {
      "source": "/batch-studio/",
      "destination": "/batch-studio/index.html"
    },
    {
      "source": "/bookmarklet",
      "destination": "/bookmarklet/index.html"
    },
    {
      "source": "/bookmarklet/",
      "destination": "/bookmarklet/index.html"
    },
    {
      "source": "/api/process-batch",
      "destination": "/api/ai-vision.js"
    },
    {
      "source": "/api/v2/jobs/:path*",
      "destination": "/api/jobs.js"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
