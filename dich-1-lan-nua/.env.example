# Comic Translation Studio - Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage & Temporary Files
TEMP_STORAGE_DIR=storage/temp
MAX_UPLOAD_SIZE_MB=50

# Worker & Queue
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=300

# Default Translation Provider (User key provided via UI or server default)
DEFAULT_TRANSLATION_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# OCR Engine Configuration (easyocr, contour, mock)
OCR_ENGINE=easyocr
OCR_LANGUAGES=["en", "ja", "ko", "ch_sim"]

# Inpainting Engine Configuration (opencv_telea, opencv_ns, lama)
INPAINTING_ENGINE=opencv_telea
